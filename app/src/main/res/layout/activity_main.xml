<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">
        
        <TextView
            android:id="@+id/tvUserStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chưa đăng nhập"
            android:textSize="14sp"
            android:textStyle="italic" />

        <Button
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đăng nhập Google" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        android:layout_marginBottom="10dp"/>

    <Switch
        android:id="@+id/switchShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tự động đồng bộ (Chia sẻ SMS)"
        android:textSize="16sp"
        android:padding="10dp"/>

    <Button
        android:id="@+id/btnSyncManual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Đồng bộ thủ công ngay" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tin nhắn đã đồng bộ:"
        android:layout_marginTop="20dp"
        android:textStyle="bold"/>

    <ListView
        android:id="@+id/listViewSms"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp" />
</LinearLayout>
